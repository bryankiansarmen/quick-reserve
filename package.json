{
  "name": "quick-reserve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --exclude '**/*.integration.test.*' --exclude '**/*.api.test.*'",
    "test:watch": "vitest --exclude '**/*.integration.test.*' --exclude '**/*.api.test.*'",
    "test:integration": "cross-env TEST_INTEGRATION=true vitest run integration.test",
    "test:integration:watch": "cross-env TEST_INTEGRATION=true vitest integration.test",
    "test:api": "cross-env TEST_INTEGRATION=true vitest run api.test",
    "test:all": "cross-env TEST_INTEGRATION=true vitest run",
    "test:coverage": "vitest run --coverage --exclude '**/*.integration.test.*' --exclude '**/*.api.test.*'",
    "test:coverage:integration": "cross-env TEST_INTEGRATION=true vitest run integration.test --coverage",
    "test:coverage:all": "cross-env TEST_INTEGRATION=true vitest run --coverage"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
