NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Quick Reserve webhook service — used to send booking cancellation emails
# after a successful cancel. The service resolves the parties' email addresses
# with its service-role key, so the Next.js app never holds one.
# Both must be set for cancellation emails; if unset, cancels still succeed
# and the email step is skipped with a logged warning.
WEBHOOK_SERVICE_URL=
INTERNAL_NOTIFICATION_TOKEN=
